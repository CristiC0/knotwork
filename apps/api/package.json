{
  "name": "@knotwork/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "openapi:generate": "nest build && node dist/openapi.js",
    "typeorm": "typeorm -d dist/database/data-source.js",
    "migration:create": "typeorm migration:create",
    "migration:generate": "nest build && typeorm -d dist/database/data-source.js migration:generate",
    "migration:run": "nest build && typeorm -d dist/database/data-source.js migration:run",
    "migration:revert": "nest build && typeorm -d dist/database/data-source.js migration:revert",
    "migration:show": "nest build && typeorm -d dist/database/data-source.js migration:show",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
