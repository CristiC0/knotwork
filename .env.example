# Copy to .env (never commit .env):  cp .env.example .env
# The API and test variables below are validated by Zod (apps/api/src/config/env.ts);
# the Docker ones are read only by compose.yaml.

# --- Docker dev services (compose.yaml) ---------------------------------------
POSTGRES_USER=knotwork
POSTGRES_PASSWORD=knotwork
POSTGRES_DB=knotwork
# Host ports. Non-default so they don't clash with other local Postgres instances.
DB_PORT=5442
TEST_DB_PORT=5443

# --- API (apps/api) -----------------------------------------------------------
# NODE_ENV is deliberately NOT set here: the API defaults to "development", and
# a NODE_ENV in this file would leak into Vite and break production web builds.
API_PORT=3000
DATABASE_URL=postgres://knotwork:knotwork@localhost:5442/knotwork
# Swagger UI at /api/docs. Off unless set, so deployments never expose it by accident.
API_DOCS_ENABLED=true
# Apply pending migrations when the API starts (off by default; use `pnpm db:migrate`).
DB_MIGRATIONS_RUN=false

# --- Integration tests (apps/api/test) ----------------------------------------
# Points at the throwaway db-test container, never the dev database.
TEST_DATABASE_URL=postgres://knotwork:knotwork@localhost:5443/knotwork_test
